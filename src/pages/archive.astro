---
import DefaultLayout from "../layouts/default.astro";
import RadioPlayer from "../components/radio-player.astro";
import { getCollection } from "astro:content";

const episodes = (await getCollection("episodes"))
  .filter((ep) => ep.data.published === true)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );

const first = episodes[0];
const firstDate = first
  ? new Date(first.data.date)
      .toLocaleDateString("en-US", {
        month: "2-digit",
        day: "2-digit",
        year: "numeric",
      })
      .replace(/\//g, ".")
  : "";
---

<DefaultLayout title="Archive — Consolidated Radio" hideVisualizer scrollNav>
  <div class="archive-flow">
    <div class="archive-content">
      <div class="ep-list" id="epList">
        {
          episodes.map((ep, i) => {
            const dateStr = new Date(ep.data.date)
              .toLocaleDateString("en-US", {
                month: "2-digit",
                day: "2-digit",
                year: "numeric",
              })
              .replace(/\//g, ".");

            return (
              <>
                {i === 0 && <div class="latest-label">LATEST EPISODE</div>}

                <div
                  class={`ep-card-wrapper${i === 0 ? " active" : ""}`}
                  data-title={ep.data.title}
                  data-date={dateStr}
                  data-desc={ep.data.description}
                  data-tracks={JSON.stringify(ep.data.tracks)}
                >
                  <RadioPlayer
                    title={ep.data.title}
                    image={ep.data.image}
                    description={ep.data.description}
                    audioSrc={ep.data.audioSrc}
                    tracks={ep.data.tracks}
                    hideInfoPanel
                  />
                </div>
              </>
            );
          })
        }
      </div>

      <div class="ep-detail" id="epDetail">
        <div class="detail-header" id="detailTitle">
          {first ? first.data.title : "SELECT AN EPISODE"}
        </div>

        <div
          class="detail-desc-box"
          id="detailDesc"
          style={first ? "" : "display:none"}
        >
          <div class="detail-desc-label">DESCRIPTION:</div>

          <div class="detail-description" id="descText">
            {first ? first.data.description : ""}
          </div>

          <div class="detail-date" id="descDate">{firstDate}</div>
        </div>

        <div
          class="detail-track-box"
          id="detailTrack"
          style={first ? "" : "display:none"}
        >
          <div class="detail-tracklist-label">TRACKLIST:</div>

          <div class="detail-tracklist" id="tracklistEl">
            {
              first &&
                first.data.tracks.map(
                  (t: { artist: string; title: string }) => (
                    <div class="track-row">
                      <div class="dot" />
                      <div class="track-name">
                        {t.artist} - {t.title}
                      </div>
                    </div>
                  ),
                )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</DefaultLayout>

<style>
  .archive-flow {
    position: relative;
    z-index: 1;
    min-height: 100dvh;
    padding-top: 30vh;
    box-sizing: border-box;
  }

  .archive-content {
    display: grid;
    grid-template-columns: 480px 1fr;
    gap: 28px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 60px;
    align-items: start;
  }

  /* ── LEFT: EPISODE LIST ────────────────────── */

  /* No inner scroll container — the list runs its full length and the page
     scrolls instead, with the detail panel staying stuck alongside it. */
  .ep-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-right: 8px;
  }

  .latest-label {
    font-family: "OPTIImprovNewWideNine", sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: #ffecdc;
    text-align: center;
    padding-bottom: 2px;
  }

  /* ── CARD WRAPPER ──────────────────────────── */

  .ep-card-wrapper {
    cursor: pointer;
    border-radius: 20px;
    transition:
      transform 0.12s,
      box-shadow 0.2s;
  }

  .ep-card-wrapper:hover {
  }

  .ep-card-wrapper.active {
    border-radius: 20px;
  }

  .ep-card-wrapper :global(.radio-player-root) {
    width: 100%;
    padding-bottom: 0;
    margin: 0;
  }

  /* ── RIGHT: DETAIL PANEL ──────────────────── */

  .ep-detail {
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: sticky;
    top: 30vh;
    padding-top: 22px;

    /*
     * Episode transition.
     * The detail panel fades and slides slightly to the side when
     * changing episodes.
     */
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 0.28s ease,
      transform 0.28s ease;

    will-change: opacity, transform;
  }

  /*
   * Directional animation classes.
   *
   * The JavaScript adds one of these before changing the content.
   */
  .ep-detail.is-changing {
    opacity: 0;
  }

  .ep-detail.is-changing-left {
    transform: translateX(-18px);
  }

  .ep-detail.is-changing-right {
    transform: translateX(18px);
  }

  .detail-header {
    font-family: "OPTIImprovNewWideNine", sans-serif;
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: 0.04em;
    color: #ffecdc;
    border-bottom: 4px solid #ffecdc;
    padding-bottom: 12px;
  }

  /* ── DESCRIPTION BOX ───────────────────────── */

  .detail-desc-box {
    background: #ffecdc;
    border: 2px solid #ffecdc;
    border-radius: 18px;
    font-family: "OPTIImprovNewWideNine", sans-serif;
    overflow: hidden;
  }

  .detail-desc-label {
    padding: 4px 13px 6px;
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #000;
  }

  .detail-description {
    font-size: 0.65rem;
    line-height: 1.7;
    color: #ffecdc;
    text-align: justify;
    background: #000;
    padding: 10px 16px;
  }

  .detail-date {
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: #000;
    font-weight: 900;
    background: #ffecdc;
    padding: 2px 13px;
  }

  /* ── TRACKLIST BOX ─────────────────────────── */

  .detail-track-box {
    background: #ffecdc;
    border: 2px solid #ffecdc;
    border-radius: 18px;
    overflow: hidden;
    font-family: "OPTIImprovNewWideNine", sans-serif;
  }

  .detail-tracklist-label {
    padding: 4px 13px 6px;
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #000;
  }

  .detail-tracklist {
    display: flex;
    flex-direction: column;
  }

  .detail-tracklist :global(.track-row) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: #000;
    border-bottom: 1.5px solid #ffecdc;
  }

  .detail-tracklist :global(.track-row:last-child) {
    border-bottom: none;
  }

  .detail-tracklist :global(.dot) {
    width: 6px;
    height: 6px;
    background: #ffecdc;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .detail-tracklist :global(.track-name) {
    font-family: "OPTIImprovNewWideNine", sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.07em;
    color: #ffecdc;
    font-weight: 900;
  }

  /* ── REDUCED MOTION ───────────────────────── */

  @media (prefers-reduced-motion: reduce) {
    .ep-detail {
      transition: none;
    }

    .ep-detail.is-changing,
    .ep-detail.is-changing-left,
    .ep-detail.is-changing-right {
      transform: none;
    }
  }

  /* ── RESPONSIVE ────────────────────────────── */

  @media (max-width: 900px) {
    .archive-flow {
      padding-top: 28vh;
    }

    .archive-content {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 0 14px 40px;
    }

    .ep-list {
      padding-right: 0;
    }

    .ep-detail {
      position: static;
      border-top: 2px solid rgba(255, 236, 220, 0.15);
      padding-top: 20px;
    }

    /*
     * On mobile the detail panel is moved inline, directly beneath
     * the selected card.
     */
    .ep-list .ep-detail {
      border-top: none;
      gap: 10px;
      padding-top: 0;
      padding-bottom: 14px;
    }

    /* The card right above it already shows the title. */
    .ep-list .ep-detail .detail-header {
      display: none;
    }

    /*
     * Slightly smaller movement on mobile so the transition
     * doesn't feel too dramatic on a small screen.
     */
    .ep-detail.is-changing-left {
      transform: translateX(-10px);
    }

    .ep-detail.is-changing-right {
      transform: translateX(10px);
    }
  }
</style>

<script>
  const wrappers =
    document.querySelectorAll<HTMLDivElement>(".ep-card-wrapper");

  const detailEl = document.getElementById("epDetail")!;
  const contentEl = document.querySelector<HTMLDivElement>(".archive-content")!;
  const mobile = window.matchMedia("(max-width: 900px)");

  /*
   * Prevents multiple overlapping animations if the user
   * clicks several episodes quickly.
   */
  let animationTimer: number | null = null;

  /*
   * Keep track of which episode was previously selected.
   * This lets the detail panel slide in different directions.
   */
  let previousIndex = 0;

  /**
   * On mobile the detail panel lives inline, right under the selected card.
   * On desktop it sits in its own column beside the list.
   */
  function placeDetail() {
    if (mobile.matches) {
      const active = document.querySelector<HTMLDivElement>(
        ".ep-card-wrapper.active",
      );

      if (active && active.nextElementSibling !== detailEl) {
        active.after(detailEl);
      }
    } else if (detailEl.parentElement !== contentEl) {
      contentEl.appendChild(detailEl);
    }
  }

  mobile.addEventListener("change", placeDetail);

  /*
   * Change the episode information with an animated transition.
   */
  function selectEpisode(wrapper: HTMLDivElement) {
    const wrapperIndex = Array.from(wrappers).indexOf(wrapper);

    /*
     * Don't restart the animation if the user clicks
     * the episode that's already selected.
     */
    if (wrapper.classList.contains("active")) {
      return;
    }

    /*
     * Determine which direction the new information should enter from.
     */
    const direction = wrapperIndex > previousIndex ? "right" : "left";

    previousIndex = wrapperIndex;

    /*
     * Cancel any previous pending content swap.
     */
    if (animationTimer !== null) {
      window.clearTimeout(animationTimer);
      animationTimer = null;
    }

    /*
     * Update the active episode immediately so mobile's
     * placeDetail() knows where the panel belongs.
     */
    wrappers.forEach((w) => w.classList.remove("active"));
    wrapper.classList.add("active");

    /*
     * Start the outgoing animation.
     */
    detailEl.classList.remove("is-changing-left", "is-changing-right");

    detailEl.classList.add(
      "is-changing",
      direction === "right" ? "is-changing-right" : "is-changing-left",
    );

    /*
     * Wait for the outgoing animation to finish before
     * replacing the actual content.
     */
    animationTimer = window.setTimeout(() => {
      const title = wrapper.dataset.title!;
      const desc = wrapper.dataset.desc!;
      const date = wrapper.dataset.date!;

      const tracks: { artist: string; title: string }[] = JSON.parse(
        wrapper.dataset.tracks!,
      );

      /*
       * Update title.
       */
      document.getElementById("detailTitle")!.textContent = title;

      /*
       * Update description and date.
       */
      document.getElementById("descText")!.textContent = desc;
      document.getElementById("descDate")!.textContent = date;

      document.getElementById("detailDesc")!.style.display = "";
      document.getElementById("detailTrack")!.style.display = "";

      /*
       * Rebuild tracklist.
       */
      const tl = document.getElementById("tracklistEl")!;

      tl.innerHTML = tracks
        .map(
          (t) =>
            `<div class="track-row">
              <div class="dot"></div>
              <div class="track-name">${t.artist} - ${t.title}</div>
            </div>`,
        )
        .join("");

      /*
       * On mobile this moves the information panel
       * underneath the newly selected episode.
       */
      placeDetail();

      /*
       * Force the browser to recognize the new position before
       * starting the incoming animation.
       */
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          detailEl.classList.remove(
            "is-changing",
            "is-changing-left",
            "is-changing-right",
          );
        });
      });

      animationTimer = null;
    }, 280);
  }

  /*
   * Make every episode card selectable.
   */
  wrappers.forEach((wrapper, index) => {
    wrapper.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      /*
       * Don't change the selected episode when the user is
       * interacting with the audio scrubber or volume control.
       */
      if (target.closest(".scrubber-track") || target.closest(".vol-track")) {
        return;
      }

      previousIndex = previousIndex ?? index;
      selectEpisode(wrapper);
    });
  });

  /*
   * Set up the initial episode.
   */
  if (wrappers.length > 0) {
    const firstWrapper = wrappers[0];

    if (!firstWrapper.classList.contains("active")) {
      firstWrapper.classList.add("active");
    }

    previousIndex = 0;
    placeDetail();
  } else {
    placeDetail();
  }
</script>
